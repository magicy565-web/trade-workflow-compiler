{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "context": {
      "type": "object",
      "properties": {
        "companyName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 0,
          "maxItems": 100
        },
        "targetMarkets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 0,
          "maxItems": 100
        },
        "goal": {
          "type": "string",
          "minLength": 0,
          "maxLength": 3000
        },
        "budgetMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "const": "USD"
        },
        "facts": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "companyName",
        "products",
        "targetMarkets",
        "goal",
        "budgetMicros",
        "currency",
        "facts"
      ],
      "additionalProperties": false
    },
    "playbook": {
      "enum": [
        "buyer-development",
        "inquiry-quote",
        "sample-followup"
      ]
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "next": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(END|[a-z][a-z0-9_-]*)$"
              },
              "type": {
                "enum": [
                  "agent_task",
                  "action"
                ]
              },
              "capability": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "capabilityVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "capabilityHash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(\\$context|[a-z][a-z0-9_-]*)$"
              },
              "inputContract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "outputContract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "maxCostMicros": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "maxAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "approvalNode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_-]*$"
              }
            },
            "required": [
              "id",
              "label",
              "next",
              "type",
              "capability",
              "capabilityVersion",
              "capabilityHash",
              "input",
              "inputContract",
              "outputContract",
              "maxCostMicros",
              "timeoutSeconds",
              "maxAttempts"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "next": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(END|[a-z][a-z0-9_-]*)$"
              },
              "type": {
                "const": "human_approval"
              },
              "actionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(\\$context|[a-z][a-z0-9_-]*)$"
              },
              "role": {
                "const": "approver"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 604800
              },
              "onReject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(END|[a-z][a-z0-9_-]*)$"
              },
              "onTimeout": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(END|[a-z][a-z0-9_-]*)$"
              }
            },
            "required": [
              "id",
              "label",
              "next",
              "type",
              "actionId",
              "input",
              "role",
              "timeoutSeconds",
              "onReject",
              "onTimeout"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "next": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(END|[a-z][a-z0-9_-]*)$"
              },
              "type": {
                "const": "wait_event"
              },
              "eventType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "correlationFrom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "correlationField": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "outputContract": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2592000
              },
              "onTimeout": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(END|[a-z][a-z0-9_-]*)$"
              }
            },
            "required": [
              "id",
              "label",
              "next",
              "type",
              "eventType",
              "correlationFrom",
              "correlationField",
              "outputContract",
              "timeoutSeconds",
              "onTimeout"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "next": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(END|[a-z][a-z0-9_-]*)$"
              },
              "type": {
                "const": "decision"
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(\\$context|[a-z][a-z0-9_-]*)$"
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "equals": {},
              "otherwise": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(END|[a-z][a-z0-9_-]*)$"
              }
            },
            "required": [
              "id",
              "label",
              "next",
              "type",
              "input",
              "field",
              "equals",
              "otherwise"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 50
    },
    "policy": {
      "type": "object",
      "properties": {
        "fourEyes": {
          "const": true
        },
        "maxRunSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5184000
        },
        "maxTransitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "fourEyes",
        "maxRunSeconds",
        "maxTransitions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "tenantId",
    "title",
    "request",
    "context",
    "playbook",
    "entry",
    "nodes",
    "policy"
  ],
  "additionalProperties": false
}
