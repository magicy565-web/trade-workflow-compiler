{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "companyName": {
      "type": "string",
      "minLength": 0,
      "maxLength": 200
    },
    "products": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "minItems": 0,
      "maxItems": 100
    },
    "targetMarkets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "minItems": 0,
      "maxItems": 100
    },
    "goal": {
      "type": "string",
      "minLength": 0,
      "maxLength": 3000
    },
    "budgetMicros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "const": "USD"
    },
    "facts": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "companyName",
    "products",
    "targetMarkets",
    "goal",
    "budgetMicros",
    "currency",
    "facts"
  ],
  "additionalProperties": false
}
