{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recipient": {
            "type": "string",
            "format": "email"
          },
          "providerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "recipient",
          "providerId",
          "acceptedAt"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "required": [
    "correlationId",
    "receipts"
  ],
  "additionalProperties": false
}
