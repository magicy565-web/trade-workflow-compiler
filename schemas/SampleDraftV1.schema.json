{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "customer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 5000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "verification": {
            "enum": [
              "source_observed",
              "unverified"
            ]
          }
        },
        "required": [
          "url",
          "capturedAt",
          "excerpt",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 50
    }
  },
  "required": [
    "customer",
    "product",
    "quantity",
    "address",
    "notes",
    "evidence"
  ],
  "additionalProperties": false
}
