{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "correlationId",
    "requestId",
    "acceptedAt"
  ],
  "additionalProperties": false
}
