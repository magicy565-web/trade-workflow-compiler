{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "format": "email"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\r\\n]+$"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "capturedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "verification": {
                  "enum": [
                    "source_observed",
                    "unverified"
                  ]
                }
              },
              "required": [
                "url",
                "capturedAt",
                "excerpt",
                "verification"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          },
          "claimReview": {
            "const": "human_required"
          }
        },
        "required": [
          "to",
          "subject",
          "body",
          "evidence",
          "claimReview"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "required": [
    "messages"
  ],
  "additionalProperties": false
}
