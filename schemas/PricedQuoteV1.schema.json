{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "to": {
      "type": "string",
      "format": "email"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "quote": {
      "type": "object",
      "properties": {
        "quote_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "state": {
          "const": "issued"
        },
        "seller": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "customer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "product_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quantity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {
          "enum": [
            "piece",
            "meter",
            "kilogram",
            "set",
            "pair"
          ]
        },
        "currency": {
          "enum": [
            "USD",
            "CNY",
            "EUR",
            "GBP",
            "JPY",
            "CAD",
            "AUD",
            "AED",
            "KWD"
          ]
        },
        "unit_price": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "total": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "incoterm": {
          "enum": [
            "EXW",
            "FCA",
            "FOB",
            "CIF",
            "DAP"
          ]
        },
        "named_place": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "edition": {
          "const": "2020"
        },
        "payment_terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "lead_time_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 730
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "delivery_status": {
          "const": "NOT_SENT"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "quote_number",
        "state",
        "seller",
        "customer",
        "description",
        "product_id",
        "product_revision",
        "quantity",
        "unit",
        "currency",
        "unit_price",
        "total",
        "incoterm",
        "named_place",
        "edition",
        "payment_terms",
        "lead_time_days",
        "valid_until",
        "delivery_status",
        "note"
      ],
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "trade-pricing-engine"
        },
        "quoteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "customerHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]+$"
        }
      },
      "required": [
        "provider",
        "quoteId",
        "customerHash"
      ],
      "additionalProperties": false
    },
    "claimReview": {
      "const": "human_required"
    }
  },
  "required": [
    "to",
    "subject",
    "body",
    "quote",
    "pricing",
    "claimReview"
  ],
  "additionalProperties": false
}
