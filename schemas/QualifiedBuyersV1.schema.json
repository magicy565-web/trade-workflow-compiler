{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "buyers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "website": {
            "type": "string",
            "format": "uri"
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "capturedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "verification": {
                  "enum": [
                    "source_observed",
                    "unverified"
                  ]
                }
              },
              "required": [
                "url",
                "capturedAt",
                "excerpt",
                "verification"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        },
        "required": [
          "companyName",
          "website",
          "evidence",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 50
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 100
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "verification": {
            "enum": [
              "source_observed",
              "unverified"
            ]
          }
        },
        "required": [
          "url",
          "capturedAt",
          "excerpt",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 50
    }
  },
  "required": [
    "buyers",
    "exclusions",
    "evidence"
  ],
  "additionalProperties": false
}
