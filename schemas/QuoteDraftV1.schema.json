{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "to": {
      "type": "string",
      "format": "email"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "terms": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "priceMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "moq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leadDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "validityDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        }
      },
      "required": [
        "currency",
        "priceMinor",
        "moq",
        "leadDays",
        "validityDate"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "verification": {
            "enum": [
              "source_observed",
              "unverified"
            ]
          }
        },
        "required": [
          "url",
          "capturedAt",
          "excerpt",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 50
    },
    "claimReview": {
      "const": "human_required"
    }
  },
  "required": [
    "to",
    "subject",
    "body",
    "terms",
    "evidence",
    "claimReview"
  ],
  "additionalProperties": false
}
