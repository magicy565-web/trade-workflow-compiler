{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": "src", "outDir": "dist", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": false,
    "declaration": true, "sourceMap": true, "skipLibCheck": true,
    "types": ["node"], "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
