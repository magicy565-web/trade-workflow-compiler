# Defaults are local-only. Never expose a plain HTTP deployment publicly.
HOST=127.0.0.1
PORT=8787
TWC_DATA_DIR=data
TWC_SCHEDULER=embedded
# TWC_PUBLIC_ORIGIN=https://your-authenticated-domain
# TWC_REGISTRY_FILE=data/capabilities.local.json
# TWC_AUTH_FILE=data/auth.local.json

# Optional semantic selector; no model is called unless /api/plan is explicitly requested.
TWC_PLANNER_ENDPOINT=
TWC_PLANNER_KEY=
TWC_PLANNER_MODEL=

# Set only when using a properly isolated OpenMausBot profile.
OPENMAUSBOT_URL=
OPENMAUSBOT_TOKEN=

# Optional controlled business gateway. Create the real gateway before enabling an external capability.
TWC_GATEWAY_SECRET=

# Optional trusted normalized event ingress. Default file created by init contains [].
# TWC_EVENT_SOURCES_FILE=data/event-sources.local.json
# TWC_MAIL_EVENTS_SECRET must be a locally generated random secret, at least 32 bytes.
# Never put a real secret in this example file or source control.

# Optional finalized pricing quote integration. Viewer role only; values stay local.
TWC_PRICING_VIEWER_TOKEN=
TWC_PRICED_GATEWAY_SECRET=
